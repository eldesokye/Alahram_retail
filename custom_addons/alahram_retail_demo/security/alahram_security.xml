<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Group 1: Owner / Chairman -->
        <record id="group_alahram_owner" model="res.groups">
            <field name="name">صاحب الشركة / رئيس مجلس الإدارة (Executive BI &amp; AI)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group 2: Operations Manager -->
        <record id="group_alahram_ops_manager" model="res.groups">
            <field name="name">مدير العمليات والتوسع (Operations Manager)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group 3: Branch Manager (Sidi Gaber) -->
        <record id="group_alahram_branch_manager" model="res.groups">
            <field name="name">مدير فرع سيدي جابر (اعتماد الخصومات > 5%)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group 4: Salesperson (Showroom Tablet) -->
        <record id="group_alahram_salesperson" model="res.groups">
            <field name="name">بائع صالة عرض سيدي جابر (تابلت المبيعات وباكدج العروسة)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group 5: Cashier 1 -->
        <record id="group_alahram_cashier1" model="res.groups">
            <field name="name">كاشير 1 سيدي جابر (خزينة نقدية 1)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group 6: Cashier 2 -->
        <record id="group_alahram_cashier2" model="res.groups">
            <field name="name">كاشير 2 سيدي جابر (خزينة نقدية 2)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group 7: Warehouseman (Roshdy / Louran) -->
        <record id="group_alahram_warehouseman" model="res.groups">
            <field name="name">أمين مخزن رشدي / لوران (اعتماد الشحن التحويلي)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
