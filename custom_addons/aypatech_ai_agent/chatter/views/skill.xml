<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="chatter_view_aypatech_wooai_skill_search" model="ir.ui.view">
        <field name="name">aypatech.ai.skill.search.category</field>
        <field name="model">aypatech_wooai.skill</field>
        <field name="inherit_id" ref="aypatech_ai_agent.skills_view_aypatech_wooai_skill_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='skill_type']" position="after">
                <field name="category"/>
            </xpath>
            <xpath expr="//filter[@name='group_type']" position="after">
                <filter
                    name="group_category"
                    string="Category"
                    context="{'group_by': 'category'}"
                />
            </xpath>
        </field>
    </record>

    <record id="chatter_view_aypatech_wooai_skill_list" model="ir.ui.view">
        <field name="name">aypatech.ai.skill.list.category</field>
        <field name="model">aypatech_wooai.skill</field>
        <field name="inherit_id" ref="aypatech_ai_agent.skills_view_aypatech_wooai_skill_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='skill_type']" position="after">
                <field name="category" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="chatter_view_aypatech_wooai_skill_form" model="ir.ui.view">
        <field name="name">aypatech.ai.skill.form.category</field>
        <field name="model">aypatech_wooai.skill</field>
        <field name="inherit_id" ref="aypatech_ai_agent.skills_view_aypatech_wooai_skill_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='skill_type']" position="after">
                <field
                    name="category"
                    readonly="not is_editable"
                    invisible="skill_type != 'composer'"
                />
            </xpath>
        </field>
    </record>

</odoo>
