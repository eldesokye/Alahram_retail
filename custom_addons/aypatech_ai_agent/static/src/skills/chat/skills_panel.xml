<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_agent.skills_SkillsPanel">
        <div
            class="ayp_skills_panel"
            t-ref="this.rootRef"
            tabindex="-1"
            t-on-keydown="(ev) => this.onKeydown(ev)"
        >
            <div class="ayp_skills_search">
                <i class="fa fa-search"/>
                <input
                    type="text"
                    t-ref="this.searchRef"
                    class="form-control border-0 shadow-none"
                    placeholder="Search skills…"
                    t-att-value="this.state.filter"
                    t-on-input="(ev) => this.onFilterInput(ev)"
                />
            </div>
            <div class="ayp_skills_empty" t-if="!this.entries.length and !this.lockedEntries.length">
                No skill matches.
            </div>
            <t t-foreach="this.entries" t-as="entry" t-key="entry.skill.name">
                <div class="ayp_skills_group" t-if="entry.first" t-esc="entry.group"/>
                <button
                    type="button"
                    class="ayp_skill"
                    t-att-class="{ active: entry_index === this.state.activeIndex }"
                    t-on-click="() => this.pickSkill(entry_index)"
                    t-on-mouseenter="() => this.hoverSkill(entry_index)"
                >
                    <span class="ayp_skill_badge">
                        <i class="fa" t-att-class="entry.skill.icon"/>
                    </span>
                    <span class="ayp_skill_text">
                        <span class="ayp_skill_label" t-esc="entry.skill.label"/>
                        <span class="ayp_skill_preview" t-esc="entry.skill.description"/>
                    </span>
                </button>
            </t>
            <t t-if="this.lockedEntries.length">
                <div class="ayp_skills_group">Once something is open</div>
                <t t-foreach="this.lockedEntries" t-as="skill" t-key="skill.name">
                    <button type="button" class="ayp_skill ayp_skill_locked" disabled="disabled">
                        <span class="ayp_skill_badge">
                            <i class="fa" t-att-class="skill.icon"/>
                        </span>
                        <span class="ayp_skill_text">
                            <span class="ayp_skill_label" t-esc="skill.label"/>
                            <span class="ayp_skill_preview" t-esc="skill.requirement"/>
                        </span>
                    </button>
                </t>
            </t>
        </div>
    </t>

</templates>
