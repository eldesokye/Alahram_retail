<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aypatech_ai_agent.chatter_WooAISessionBox">
        <div class="o-mail-WooAISessionBox" t-if="this.props.open and this.state.loaded and this.state.total">
            <div class="d-flex align-items-center">
                <hr class="flex-grow-1"/>
                <span class="p-3 fw-bold">
                    AI Sessions
                </span>
                <hr class="flex-grow-1"/>
            </div>
            <div class="d-flex flex-column">
                <div
                    t-foreach="this.state.sessions"
                    t-as="session"
                    t-key="session.id"
                    class="o-mail-WooAISessionBox-item d-flex align-items-center gap-2 px-2 py-1 cursor-pointer"
                    role="button"
                    tabindex="0"
                    t-att-title="this.tooltip(session)"
                    t-on-click="() => this.openSession(session)"
                    t-on-keydown="(ev) => this.onItemKeydown(ev, session)"
                >
                    <span
                        class="o-mail-WooAISessionBox-state d-flex align-items-center flex-shrink-0"
                        t-att-class="this.stateBadge(session.state)"
                    >
                        <span class="o-mail-WooAISessionBox-dot"/>
                    </span>
                    <span class="o-mail-WooAISessionBox-name text-truncate flex-grow-1">
                        <t t-esc="session.name"/>
                    </span>
                    <span
                        class="o-mail-WooAISessionBox-date flex-shrink-0"
                        t-att-title="this.startedAt(session.create_date)"
                    >
                        <t t-esc="this.relativeName(session.create_date)"/>
                    </span>
                </div>
                <button
                    t-if="this.hasMore"
                    type="button"
                    class="o-mail-WooAISessionBox-more btn btn-link btn-sm align-self-center"
                    t-on-click="this.openAll"
                >
                    View all <t t-esc="this.state.total"/> sessions
                </button>
            </div>
        </div>
    </t>

</templates>
