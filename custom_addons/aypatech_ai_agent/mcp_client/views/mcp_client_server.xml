<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="mcp_client_view_server_list" model="ir.ui.view">
		<field name="name">aypatech_wooai.mcp.client.server.list</field>
		<field name="model">aypatech_wooai.mcp.client.server</field>
		<field name="arch" type="xml">
			<list>
				<field name="sequence" widget="handle"/>
				<field name="name"/>
				<field name="url"/>
				<field name="auth_type"/>
				<field name="tool_count"/>
				<field name="last_sync"/>
				<field name="last_error" optional="hide"/>
				<field name="active" widget="boolean_toggle"/>
			</list>
		</field>
	</record>

	<record id="mcp_client_view_server_form" model="ir.ui.view">
		<field name="name">aypatech_wooai.mcp.client.server.form</field>
		<field name="model">aypatech_wooai.mcp.client.server</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_sync_tools" type="object" string="Sync Tools" class="btn-primary"/>
				</header>
				<sheet>
					<div class="oe_title">
						<label for="name"/>
						<h1><field name="name" placeholder="e.g. Internal Docs Server"/></h1>
					</div>
					<group>
						<group>
							<field name="url" placeholder="https://example.com/mcp"/>
							<field name="auth_type"/>
							<field name="header_name" invisible="auth_type != 'header'"/>
							<field name="api_key" password="True" invisible="auth_type == 'none'"/>
							<field name="timeout"/>
							<field name="active"/>
						</group>
						<group>
							<field name="tool_count"/>
							<field name="last_sync" readonly="1"/>
							<field name="last_error" readonly="1" invisible="not last_error"/>
						</group>
					</group>
					<field name="description" placeholder="What this server is for..."/>
					<notebook>
						<page string="Tools" name="tools">
							<field name="tool_ids" readonly="1">
								<list>
									<field name="name"/>
									<field name="description"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="mcp_client_action_server" model="ir.actions.act_window">
		<field name="name">External MCP Servers</field>
		<field name="res_model">aypatech_wooai.mcp.client.server</field>
		<field name="view_mode">list,form</field>
	</record>

</odoo>
