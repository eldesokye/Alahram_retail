<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="mcp_view_mcp_notification_list" model="ir.ui.view">
		<field name="name">aypatech_woomcp.notification.list</field>
		<field name="model">aypatech_woomcp.notification</field>
		<field name="arch" type="xml">
			<list create="false">
				<field name="event_id"/>
				<field name="session_id"/>
				<field name="method"/>
				<field name="params"/>
				<field name="delivered"/>
				<field name="create_date"/>
			</list>
		</field>
	</record>

	<record id="mcp_action_mcp_notification" model="ir.actions.act_window">
		<field name="name">Notifications</field>
		<field name="res_model">aypatech_woomcp.notification</field>
		<field name="view_mode">list</field>
		<field name="path">commerce-mcp-notifications</field>
	</record>

</odoo>
