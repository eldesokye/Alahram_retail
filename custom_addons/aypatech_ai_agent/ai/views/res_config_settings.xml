<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="ai_view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.aypatech_wooai</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//form" position="inside">
				<app data-string="AI Agent" string="AI Agent" name="aypatech_ai_agent">
					<block title="AI Provider" name="woo_settings_ai_provider">
						<setting
							id="aypatech_wooai_default_provider"
							string="Provider"
							help="The AI service that answers the assistant."
						>
							<field name="wooai_provider_id" options="{'no_create': True, 'no_open': True}"/>
						</setting>
						<setting
							id="woo_settings_ai_model"
							string="Model"
							help="Used when an agent does not specify a model of its own."
						>
							<field name="wooai_model_id" options="{'no_create': True, 'no_open': True}"
								required="wooai_provider_id"/>
						</setting>
						<setting
							id="woo_settings_ai_key"
							string="API Key"
							help="Get it from the provider's website. It is stored on the server and never shown again."
						>
							<field name="wooai_api_key" password="True" placeholder="Paste the key here" class="w-100"
								invisible="wooai_has_key"/>
							<field name="wooai_api_key" password="True" placeholder="Saved. Paste a new key to replace it" class="w-100"
								invisible="not wooai_has_key"/>
							<div class="mt8" invisible="not wooai_tested_at">
								<span class="text-success" invisible="not wooai_test_ok">
									<i class="fa fa-check me-1"/><field name="wooai_test_message" class="oe_inline"/>
								</span>
								<span class="text-danger" invisible="wooai_test_ok">
									<i class="fa fa-exclamation-triangle me-1"/><field name="wooai_test_message" class="oe_inline"/>
								</span>
								<div class="text-muted small">Last tested <field name="wooai_tested_at" class="oe_inline" readonly="1"/></div>
							</div>
							<div class="text-muted mt8" invisible="wooai_tested_at or not wooai_has_key">
								The key is saved but has not been tested yet.
							</div>
							<button name="action_wooai_test_connection" type="object" string="Save and Test Connection"
								icon="fa-plug" class="btn-secondary mt8"/>
							<button name="action_wooai_clear_key" type="object" string="Remove Key"
								icon="fa-trash" class="btn-link text-danger mt8" invisible="not wooai_has_key"
								confirm="Remove the saved API key? The AI assistant will stop working until a new key is entered."/>
						</setting>
						<setting
							id="aypatech_wooai_default_agent"
							string="Default Agent"
							help="Agent picked first when a new chat starts."
						>
							<field name="wooai_agent_id" options="{'no_create': True}"/>
						</setting>
						<setting
							id="aypatech_wooai_more_providers"
							string="More Providers and Models"
							help="Every configured provider, with its curated model catalog and API keys."
						>
							<button name="%(ai_action_aypatech_wooai_provider)d" type="action" string="Manage Providers"
								icon="oi-arrow-right" class="btn-link"/>
							<button name="%(ai_action_ai_agent)d" type="action" string="Manage Agents"
								icon="oi-arrow-right" class="btn-link"/>
						</setting>
					</block>
					<block title="Assistant Limits" name="aypatech_wooai_settings_limits">
						<setting id="aypatech_wooai_max_iterations">
							<label string="Iteration Limit" for="wooai_max_iterations"/>
							<div class="text-muted">
								The model is warned shortly before the limit so it can wrap up.							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Max rounds" for="wooai_max_iterations"/>
										<field name="wooai_max_iterations" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">per Slice</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="aypatech_wooai_turn_wallclock">
							<label string="Turn Runtime" for="wooai_turn_wallclock_seconds"/>
							<div class="text-muted">
								A user turn exceeding this across all slices stops with an error.							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="wooai_turn_wallclock_seconds"/>
										<field name="wooai_turn_wallclock_seconds" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">in Seconds</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="aypatech_wooai_slice_wallclock">
							<label string="Slice Runtime" for="wooai_slice_wallclock_seconds"/>
							<div class="text-muted">
								A worker slice exceeding this is checkpointed and resumed by a fresh worker.							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="wooai_slice_wallclock_seconds"/>
										<field name="wooai_slice_wallclock_seconds" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">in Seconds</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="aypatech_wooai_turn_cost_limit">
							<label string="Cost Limit" for="wooai_turn_cost_limit"/>
							<div class="text-muted">
								Maximum spend per user turn in the model's price currency. Set to 0 to disable.
							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Max spend" for="wooai_turn_cost_limit"/>
										<field name="wooai_turn_cost_limit" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">per Turn</span>
									</div>
								</div>
							</div>
						</setting>
					</block>
					<block title="Assistant Housekeeping" name="aypatech_wooai_settings_autovacuum">
						<setting
							id="aypatech_wooai_client_action_timeout"
							string="Give Up on Stale Actions"
							help="Answer for a browser that never carried out an action a chat asked for, so the turn is not left waiting for good."
						>
							<div class="content-group">
								<div class="row">
									<div class="o_light_label">
										<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Wait for" for="wooai_client_action_timeout"/>
										<field name="wooai_client_action_timeout" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">Seconds</span>
									</div>
								</div>
							</div>
						</setting>
						<setting
							id="aypatech_wooai_session_retention"
							string="Delete Old Chats"
							help="Delete finished chats once they are old enough. A chat that is still running is never touched."
						>
							<field name="wooai_session_retention_enabled"/>
							<div class="content-group mt16" invisible="not wooai_session_retention_enabled">
								<div class="row">
									<div class="o_light_label">
										<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Keep Chats for" for="wooai_session_retention_days"/>
										<field name="wooai_session_retention_days" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">Days</span>
									</div>
								</div>
							</div>
						</setting>
					</block>
					<block title="MCP Server" name="aypatech_wooai_mcp_settings">
						<setting id="aypatech_wooai_mcp_session_timeout">
							<label string="Session Timeout" for="woomcp_session_timeout"/>
							<div class="text-muted">
								Inactive sessions are cleaned up after this period.
							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="woomcp_session_timeout"/>
										<field name="woomcp_session_timeout" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">in Hours</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="aypatech_wooai_mcp_log_retention">
							<label string="Log Retention" for="woomcp_log_retention"/>
							<div class="text-muted">
								Audit logs older than this period are automatically deleted.
							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Retention" for="woomcp_log_retention"/>
										<field name="woomcp_log_retention" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">in Days</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="aypatech_wooai_mcp_rate_limit">
							<label string="Rate Limiting" for="woomcp_rate_limit_requests"/>
							<div class="text-muted">
								Default rate limit for new API keys. Set to 0 to disable.
							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Max requests" for="woomcp_rate_limit_requests"/>
										<field name="woomcp_rate_limit_requests" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">per Minute</span>
									</div>
								</div>
							</div>
						</setting>
						<setting
							id="aypatech_wooai_mcp_annotate_messages"
							string="Annotate Messages"
							help="Mark chatter messages originating from MCP."
						>
							<field name="woomcp_annotate_messages"/>
							<button name="%(mcp_action_mcp_key)d" type="action" string="Manage API Keys"
								icon="oi-arrow-right" class="btn-link mt-3"/>
						</setting>
					</block>
					<block title="Assistant Features" name="aypatech_wooai_features">
						<setting
							id="aypatech_wooai_feature_skills"
							string="Skills"
							help="Reusable instructions that users or agents can switch into during a chat."
						>
							<button name="%(skills_action_aypatech_wooai_skill)d" type="action" string="Manage Skills"
								icon="oi-arrow-right" class="btn-link"/>
						</setting>
						<setting
							id="aypatech_wooai_feature_schedule"
							string="Schedules"
							help="Run agents on a schedule and let them pause and pick up later."
						>
							<button name="%(schedule_action_aypatech_wooai_schedule)d" type="action" string="Manage Schedules"
								icon="oi-arrow-right" class="btn-link"/>
						</setting>
						<setting
							id="aypatech_wooai_feature_automation"
							string="Automation"
							help="Run agents from server actions and automation rules."
						>
							<button name="base_automation.base_automation_act" type="action" string="Manage Automation Rules"
								icon="oi-arrow-right" class="btn-link"/>
						</setting>
						<setting
							id="aypatech_wooai_feature_reports"
							string="Scheduled Reports"
							help="Recurring agent reports delivered as PDF by e-mail or Telegram."
						>
							<button name="%(aypatech_ai_agent.reports_action_report_schedule)d" type="action" string="Manage Report Schedules"
								icon="oi-arrow-right" class="btn-link"/>
						</setting>
						<setting
							id="aypatech_wooai_feature_dashboard"
							string="Cost and Usage"
							help="Spend and token usage per agent and per user, over time."
						>
							<button name="%(aypatech_ai_agent.dashboard_action_usage)d" type="action" string="Open Dashboard"
								icon="oi-arrow-right" class="btn-link"/>
						</setting>
						<setting
							id="aypatech_wooai_feature_mcp_client"
							string="External MCP Servers"
							help="Remote MCP servers whose tools this agent can call, alongside its own."
						>
							<button name="%(aypatech_ai_agent.mcp_client_action_server)d" type="action" string="Manage MCP Servers"
								icon="oi-arrow-right" class="btn-link"/>
						</setting>
					</block>
				</app>
			</xpath>
		</field>
	</record>

	<record id="ai_action_aypatech_wooai_config_settings" model="ir.actions.act_window">
		<field name="name">Settings</field>
		<field name="res_model">res.config.settings</field>
		<field name="view_mode">form</field>
		<field name="context">{'module': 'aypatech_ai_agent', 'bin_size': False}</field>
	</record>

</odoo>
