<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="alahram_retail_demo.BranchReservationDialog">
        <Dialog title="'حجز وتوافر الفروع — شركة الأهرام'"
                size="'fs'"
                header="false"
                footer="false"
                withBodyPadding="false"
                contentClass="'alahram-branch-reservation-dialog-content'"
                bodyClass="'alahram-reservation-modal'">
            <div class="branch-reservation-container">

                <!-- 1. FULL-SCREEN HEADER BAR -->
                <div class="reservation-top-header px-3 px-md-4 py-2 shadow-sm">
                    <!-- Title + Close Bar -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-2 mb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="bg-primary text-white rounded-2 p-2 d-flex align-items-center justify-content-center">
                                <i class="oi oi-home fs-5"/>
                            </span>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">حجز وتوافر الفروع — شركة الأهرام</h5>
                                <small class="text-muted">إدارة التحويلات بين المخازن، التحقق الفوري من الرصيد، وحجوزات نقاط البيع</small>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <t t-if="this.state.bridalPackageName">
                                <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 d-flex align-items-center gap-2 fs-6">
                                    <i class="oi oi-gift"/>
                                    <span>باكدج العروسة المرتبط: <strong t-esc="this.state.bridalPackageName"/></span>
                                </div>
                            </t>

                            <button type="button"
                                    class="btn btn-outline-secondary d-flex align-items-center gap-2 fw-bold px-3"
                                    t-on-click="() => this.closeDialog()"
                                    title="إغلاق الشاشة والعودة لنقطة البيع">
                                <i class="oi oi-close"/>
                                <span>إغلاق</span>
                            </button>
                        </div>
                    </div>

                    <!-- Customer Details & Add to Cart Row -->
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5 col-lg-5">
                            <label class="form-label fw-bold text-muted small d-flex justify-content-between align-items-center mb-1">
                                <span>اسم العميل / العروسة</span>
                                <span t-if="this.state.partnerId" class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2">
                                    <i class="oi oi-check-circle me-1"/>مسجل بالنظام
                                </span>
                            </label>
                            <div class="input-group">
                                <button type="button"
                                        class="btn btn-primary d-flex align-items-center gap-1"
                                        t-on-click="() => this.selectPartner()"
                                        title="اختيار / إضافة عميل من قاعدة بيانات نقطة البيع">
                                    <i class="oi oi-user"/>
                                    <span t-if="!this.state.customerName" class="d-none d-sm-inline">اختيار عميل</span>
                                </button>
                                <input type="text"
                                       class="form-control"
                                       placeholder="اختيار عميل أو كتابة الاسم..."
                                       t-att-value="this.state.customerName"
                                       t-on-input="(e) => this.onCustomerNameInput(e.target.value)"/>
                                <button t-if="this.state.partnerId"
                                        type="button"
                                        class="btn btn-outline-secondary"
                                        t-on-click="() => this.clearPartner()"
                                        title="إلغاء ربط العميل">
                                    <i class="oi oi-close"/>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4 col-lg-4">
                            <label class="form-label fw-bold text-muted small mb-1">رقم الهاتف</label>
                            <input type="text"
                                   class="form-control text-start"
                                   placeholder="01xxxxxxxxx"
                                   t-att-value="this.state.customerPhone"
                                   t-on-input="(e) => this.onCustomerPhoneInput(e.target.value)"/>
                        </div>
                        <div class="col-md-3 col-lg-3 d-flex align-items-center justify-content-md-end pt-2 pt-md-0">
                            <div class="form-check form-switch fs-5 mb-0 bg-light px-3 py-1 rounded border w-100 d-flex align-items-center justify-content-between">
                                <label class="form-check-label fs-6 fw-semibold mb-0" for="addToCartSwitch">إضافة لسلة الكاشير</label>
                                <input class="form-check-input ms-0" type="checkbox" id="addToCartSwitch" t-model.proxy="this.state.addToCart"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. MAIN WORKSPACE — TWO-COLUMN FULL-HEIGHT LAYOUT -->
                <div class="reservation-main-workspace">
                    <div class="row g-3 reservation-columns-row">

                        <!-- RIGHT COLUMN (RTL Start): PRODUCT SEARCH & CATALOG -->
                        <div class="col-md-5 col-lg-4 catalog-column">
                            <div class="card p-3 border-0 shadow-sm catalog-card">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0 text-dark">
                                        <i class="oi oi-search me-1 text-primary"/> كتالوج الأصناف والباركود
                                    </h6>
                                    <span class="badge bg-light text-dark border" t-esc="(this.availableProducts ? this.availableProducts.length : 0) + ' صنف'"/>
                                </div>
                                <div class="input-group mb-2 flex-shrink-0">
                                    <span class="input-group-text bg-white"><i class="oi oi-search"/></span>
                                    <input type="text" class="form-control form-control-lg" placeholder="بحث بالاسم أو الباركود..." t-model.proxy="this.state.searchQuery"/>
                                </div>
                                <div class="product-search-list">
                                    <t t-foreach="this.availableProducts" t-as="prod" t-key="prod.id">
                                        <div class="product-item d-flex align-items-center justify-content-between p-2 mb-2 border rounded bg-white cursor-pointer"
                                             t-on-click="() => this.addProductToReservation(prod, 1)">
                                            <div class="d-flex flex-column text-truncate me-2">
                                                <span class="fw-bold text-truncate" t-esc="prod.display_name || prod.name || 'صنف'"/>
                                                <span class="small text-muted" t-esc="prod.barcode || prod.default_code || 'بدون باركود'"/>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                <span class="badge bg-primary fs-6" t-esc="(prod.lst_price || prod.price || 0) + ' ج.م'"/>
                                                <button type="button" class="btn btn-outline-primary btn-sm rounded-circle px-2 py-1" title="إضافة الصنف">
                                                    <i class="oi oi-plus"/>
                                                </button>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- LEFT COLUMN (RTL End): SELECTED PRODUCTS & BRANCH AVAILABILITY -->
                        <div class="col-md-7 col-lg-8 allocation-column">
                            <div class="card p-3 border-0 shadow-sm allocation-card">
                                <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2 flex-shrink-0">
                                    <h6 class="fw-bold mb-0 text-dark">
                                        <i class="oi oi-view-list me-1 text-success"/> الأصناف المختارة وتوزيع الصرف على الفروع
                                    </h6>
                                    <span class="badge bg-primary-subtle text-primary fs-6" t-esc="(this.state.selectedItems ? this.state.selectedItems.length : 0) + ' صنف مختار'"/>
                                </div>

                                <div class="selected-items-scroll-area">
                                    <t t-if="!this.state.selectedItems or this.state.selectedItems.length === 0">
                                        <div class="text-center py-5 text-muted d-flex flex-column align-items-center justify-content-center h-100">
                                            <i class="oi oi-cart display-3 mb-3 opacity-25"/>
                                            <p class="fs-5 fw-semibold mb-1">لم يتم اختيار أي أصناف بعد</p>
                                            <small class="text-muted">ابحث عن المنتج في القائمة اليمنى أو امسح الباركود لإظهار أرصدة الفروع وتوزيع الكميات.</small>
                                        </div>
                                    </t>

                                    <t t-foreach="this.state.selectedItems" t-as="item" t-key="item.product.id">
                                        <div class="item-allocation-card border rounded p-3 mb-3 bg-white shadow-sm">

                                            <!-- Item Header & Stepper -->
                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                                <div>
                                                    <h6 class="fw-bold mb-1 text-dark" t-esc="item.product.display_name || item.product.name || 'صنف'"/>
                                                    <span class="badge bg-secondary" t-esc="'سعر القطعة: ' + (item.product.lst_price || item.product.price || 0) + ' ج.م'"/>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 fs-5" t-on-click="() => this.updateRequestedQty(item, -1)">-</button>
                                                    <span class="fw-bold fs-5 px-2" t-esc="item.qty_requested"/>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 fs-5" t-on-click="() => this.updateRequestedQty(item, 1)">+</button>
                                                    <button type="button" class="btn btn-outline-danger btn-sm ms-2" t-on-click="() => this.removeProduct(item_index)" title="إزالة الصنف">
                                                        <i class="oi oi-trash"/>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Branch Real-Time Availability Badges -->
                                            <t t-set="stockItem" t-value="this.getStockInfo(item.product.id)"/>
                                            <t t-if="stockItem and stockItem.branches">
                                                <div class="branch-stock-badges d-flex flex-wrap gap-2 mb-2 p-2 bg-light rounded">
                                                    <span class="small fw-bold text-muted align-self-center">رصيد الفروع:</span>
                                                    <t t-foreach="stockItem.branches" t-as="b" t-key="b.warehouse_id">
                                                        <span t-attf-class="badge {{b.qty_free > 0 ? 'bg-success' : 'bg-secondary opacity-50'}} p-2">
                                                            <span t-esc="b.warehouse_name"/>: <strong t-esc="b.qty_free"/>
                                                        </span>
                                                    </t>
                                                </div>
                                            </t>

                                            <!-- Allocations for this item -->
                                            <div class="allocations-section mt-2">
                                                <span class="small fw-bold text-dark d-block mb-1">تخصيص الفروع وطريقة الاستلام:</span>
                                                <t t-foreach="item.allocations" t-as="alloc" t-key="alloc_index">
                                                    <div class="d-flex flex-wrap flex-sm-nowrap align-items-center gap-2 mb-2 p-2 border rounded bg-light">
                                                        <span class="fw-semibold text-truncate" style="min-width: 140px;" t-esc="alloc.warehouse_name"/>

                                                        <!-- Quantity Stepper -->
                                                        <div class="d-flex align-items-center">
                                                            <button type="button" class="btn btn-sm btn-white border px-2" t-on-click="() => this.changeAllocationQty(item, alloc, -1)">-</button>
                                                            <span class="px-2 fw-bold" t-esc="alloc.qty"/>
                                                            <button type="button" class="btn btn-sm btn-white border px-2" t-on-click="() => this.changeAllocationQty(item, alloc, 1)">+</button>
                                                        </div>

                                                        <!-- Fulfillment Type Selector -->
                                                        <select class="form-select form-select-sm flex-grow-1" t-on-change="(ev) => alloc.fulfillment_type = ev.target.value">
                                                            <option value="transfer" t-att-selected="alloc.fulfillment_type === 'transfer'">تحويل وشحن لفرع البيع (سيدي جابر)</option>
                                                            <option value="pickup" t-att-selected="alloc.fulfillment_type === 'pickup'">استلام مباشر من الفرع المصدري</option>
                                                        </select>

                                                        <button type="button" class="btn btn-link text-danger p-0" t-on-click="() => this.removeAllocation(item, alloc_index)" title="حذف التخصيص">
                                                            <i class="oi oi-close"/>
                                                        </button>
                                                    </div>
                                                </t>

                                                <!-- Add branch allocation dropdown -->
                                                <div class="d-flex align-items-center gap-2 mt-2">
                                                    <select class="form-select form-select-sm" t-on-change="(ev) => this.onSelectBranch(item, ev)">
                                                        <option value="">+ تخصيص صرف من فرع إضافي...</option>
                                                        <t t-foreach="this.state.branches" t-as="br" t-key="br.warehouse_id">
                                                            <option t-att-value="br.warehouse_id" t-esc="br.name"/>
                                                        </t>
                                                    </select>
                                                </div>
                                            </div>

                                            <!-- Allocation Status & Deficit Alert -->
                                            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                                <span class="small text-muted">
                                                    المخصص: <strong t-esc="this.getItemTotalAllocated(item)"/> من <strong t-esc="item.qty_requested"/>
                                                </span>
                                                <t t-if="this.getItemDeficit(item) > 0">
                                                    <span class="badge bg-warning text-dark p-2">
                                                        عجز <t t-esc="this.getItemDeficit(item)"/> قطعة (ستدرج في قائمة الانتظار)
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-success p-2">مكتمل التخصيص</span>
                                                </t>
                                            </div>

                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- 3. PINNED BOTTOM FOOTER TOTALS & CONFIRMATION -->
                <div class="reservation-bottom-footer bg-dark text-white px-3 px-md-4 py-2 shadow-lg">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex flex-wrap gap-3 gap-md-4 align-items-center">
                            <div>
                                <span class="text-white-50 d-block small">إجمالي المطلوب</span>
                                <h5 class="mb-0 fw-bold" t-esc="this.summaryTotals.requested"/>
                            </div>
                            <div>
                                <span class="text-white-50 d-block small">المحجوز بالمخازن</span>
                                <h5 class="mb-0 fw-bold text-success" t-esc="this.summaryTotals.reserved"/>
                            </div>
                            <div>
                                <span class="text-white-50 d-block small">قيد الانتظار (عجز)</span>
                                <h5 class="mb-0 fw-bold text-warning" t-esc="this.summaryTotals.waiting"/>
                            </div>
                            <div class="border-start border-secondary ps-3 ps-md-4">
                                <span class="text-white-50 d-block small">إجمالي القيمة التقديرية</span>
                                <h5 class="mb-0 fw-bold text-info" t-esc="this.summaryTotals.amount + ' ج.م'"/>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-light px-4 fw-semibold" t-on-click="() => this.closeDialog()">إلغاء وإغلاق</button>
                            <button type="button" class="btn btn-success px-4 px-md-5 fw-bold" t-att-disabled="this.state.isSubmitting" t-on-click="() => this.submitReservation()">
                                <t t-if="this.state.isSubmitting">
                                    <span class="spinner-border spinner-border-sm me-2"/> جاري الحفظ...
                                </t>
                                <t t-else="">
                                    <i class="oi oi-check me-1"/> تأكيد الحجز وتخصيص الفروع
                                </t>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </Dialog>
    </t>
</templates>
