<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Configure Main Company Name & Details -->
        <record id="base.main_company" model="res.company">
            <field name="name">شركة الأهرام للأدوات المنزلية</field>
            <field name="street">طريق الحرية - سيدي جابر</field>
            <field name="city">الإسكندرية</field>
            <field name="country_id" ref="base.eg"/>
            <field name="phone">+20 3 5468900</field>
            <field name="email">info@alahramcookware.com</field>
            <field name="website">https://alahramcookware.com</field>
        </record>

        <!-- Tax Group for 14% VAT -->
        <record id="tax_group_vat_14" model="account.tax.group">
            <field name="name">ضريبة القيمة المضافة 14%</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="country_id" ref="base.eg"/>
        </record>

        <!-- 14% Egyptian VAT - Sales -->
        <record id="tax_vat_14_sale" model="account.tax">
            <field name="name">ضريبة القيمة المضافة 14% (مبيعات)</field>
            <field name="type_tax_use">sale</field>
            <field name="amount_type">percent</field>
            <field name="amount">14.0</field>
            <field name="tax_group_id" ref="tax_group_vat_14"/>
            <field name="description">14% VAT</field>
            <field name="country_id" ref="base.eg"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- 14% Egyptian VAT - Purchase -->
        <record id="tax_vat_14_purchase" model="account.tax">
            <field name="name">ضريبة القيمة المضافة 14% (مشتريات)</field>
            <field name="type_tax_use">purchase</field>
            <field name="amount_type">percent</field>
            <field name="amount">14.0</field>
            <field name="tax_group_id" ref="tax_group_vat_14"/>
            <field name="description">14% VAT</field>
            <field name="country_id" ref="base.eg"/>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
