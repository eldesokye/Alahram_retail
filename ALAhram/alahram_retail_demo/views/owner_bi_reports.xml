<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report 1: Branch Analytics Tree & Pivot View -->
    <record id="view_alahram_branch_analytics_tree" model="ir.ui.view">
        <field name="name">alahram.branch.analytics.list</field>
        <field name="model">alahram.branch.analytics</field>
        <field name="arch" type="xml">
            <list string="تحليل مبيعات وربحية ومرتجعات الفروع (أكتوبر 2026)" create="false" editable="bottom">
                <field name="branch_name" readonly="1"/>
                <field name="net_sold_qty" readonly="1"/>
                <field name="gross_sales" widget="monetary" readonly="1"/>
                <field name="discount_given" widget="monetary" readonly="1"/>
                <field name="vat_14_amount" widget="monetary" readonly="1"/>
                <field name="return_qty" readonly="1" decoration-danger="return_qty &lt; 0"/>
                <field name="return_value" widget="monetary" readonly="1" decoration-danger="return_value &lt; 0"/>
                <field name="net_sales_inc_vat" widget="monetary" readonly="1" decoration-success="net_sales_inc_vat &gt; 1000000"/>
                <field name="net_sales_exc_vat" widget="monetary" readonly="1"/>
                <field name="sales_target" widget="monetary" optional="show"/>
                <field name="cogs_cost" widget="monetary" readonly="1"/>
                <field name="net_profit" widget="monetary" readonly="1" decoration-success="net_profit &gt; 100000"/>
                <field name="return_rate" widget="percentage" readonly="1" decoration-danger="return_rate &gt; 20.0" decoration-success="return_rate &lt; 10.0"/>
            </list>
        </field>
    </record>

    <!-- Report 1: Action -->
    <record id="action_alahram_branch_analytics_report" model="ir.actions.act_window">
        <field name="name">تقرير 1: أداء مبيعات وربحية ومرتجعات الفروع (أكتوبر 2026)</field>
        <field name="res_model">alahram.branch.analytics</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                بيان أداء مبيعات وربحية الفروع - المصدر الموحد للبيانات
            </p>
        </field>
    </record>

    <!-- Report 2: Dead Stock Action -->
    <record id="action_alahram_dead_stock_report" model="ir.actions.act_window">
        <field name="name">تقرير 2: تحليل المخزون الراكد وتدوير الأصناف</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_dead_stock', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                الأصناف الراكدة بدون حركة مبيعات
            </p>
            <p>
                يقوم هذا التقرير بحصر الأصناف ذات الأرصدة المرتفعة مع مبيعات صفرية في شهر أكتوبر لاستهدافها في عروض ترويجية وتخفيضات سريعة.
            </p>
        </field>
    </record>
</odoo>

