              sequence="22"/>

    <!-- 3. Scene 6: POS Discount Approvals Dashboard -->
    <menuitem id="menu_alahram_scene6_discount"
              name="المشهد 6 — إدارة موافقات الخصم"
              parent="menu_alahram_root"
              action="action_alahram_discount_approvals"
