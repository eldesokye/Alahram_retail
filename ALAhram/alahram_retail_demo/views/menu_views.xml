              action="action_alahram_cross_branch_reserve"
              sequence="30"/>

    <menuitem id="menu_alahram_chat_history"
              name="سجل 4: تاريخ محادثات شات بوت الذكاء الاصطناعي"
              parent="menu_alahram_bi_reports_parent"
              action="action_alahram_chat_history"
              sequence="40"/>
