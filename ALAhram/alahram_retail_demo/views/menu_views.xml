<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu: Al Ahram Smart Operations Center -->
    <menuitem id="menu_alahram_root"
              name="الأهرام — مركز العمليات الذكية 🍳"
              web_icon="alahram_retail_demo,static/description/icon.png"
              sequence="5"/>

    <!-- 1. Scene 3: Branch Availability & Reservation -->
    <menuitem id="menu_alahram_scene3_availability"
              name="المشهد 3 — التوافر والحجز من الفروع"
              parent="menu_alahram_root"
              action="action_alahram_scene3_availability"
              sequence="10"/>

    <!-- Multi-Branch POS Reservation Subsystem -->
    <menuitem id="menu_alahram_branch_reservation"
              name="حجوزات وتوافر الفروع"
              parent="menu_alahram_root"
              action="action_alahram_branch_reservation"
              sequence="12"/>

    <menuitem id="menu_alahram_branch_waitlist"
              name="قائمة انتظار العجز المخزني"
              parent="menu_alahram_root"
