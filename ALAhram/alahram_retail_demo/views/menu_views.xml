              sequence="14"/>

    <menuitem id="menu_pos_branch_reservation"
              name="حجوزات الفروع"
              parent="point_of_sale.menu_point_of_sale"
              action="action_alahram_branch_reservation"
              sequence="25"/>

    <!-- 2. Scene 4: Bridal Package Configurator -->
