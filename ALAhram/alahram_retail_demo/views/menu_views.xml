    <!-- 6. Interactive AI Chatbot (Web App & API) -->
    <menuitem id="menu_alahram_web_chatbot"
              name="💬 شات بوت الذكاء الاصطناعي التفاعلي"
              parent="menu_alahram_root"
              action="action_alahram_web_chatbot"
              sequence="60"/>

    <!-- 7. Executive BI & Operational Reports -->
    <menuitem id="menu_alahram_bi_reports_parent"
              name="📊 تقارير الإدارة والمتابعة التشغيلية"
              parent="menu_alahram_root"
