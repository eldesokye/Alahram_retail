    <!-- 5. Scene 13: AI Executive Assistant -->
    <menuitem id="menu_alahram_scene13_ai_assistant"
              name="المشهد 13 — مساعد الأهرام الذكي للإدارة العليا"
              parent="menu_alahram_root"
